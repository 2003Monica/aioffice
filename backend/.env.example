# NVIDIA-hosted Nemotron 3 Super API key (https://integrate.api.nvidia.com)
# Used by the Backend desk in agents.py.
NVIDIA_API_KEY=your_key_here

# Groq API key (https://console.groq.com) -- used by the Research desk
# (GPT-OSS 20B) and the Debugger desk (GPT-OSS 120B).
GROQ_API_KEY=your_key_here

# Local Ollama -- all desks: primary for Frontend/Security/SQL; fallback for NVIDIA/Groq.
# These defaults also apply when the variables are omitted.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# Copy this file to .env and fill in your real keys -- .env is gitignored
# and never committed.
